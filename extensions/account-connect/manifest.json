{
  "manifest_version": 3,
  "name": "YTB Connect",
  "version": "2.0.1",
  "description": "Connect YouTube channel access into MasterOS parent projects.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "YTB Connect",
    "default_popup": "popup.html"
  }
}
