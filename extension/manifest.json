{
  "manifest_version": 3,
  "name": "AutoCapCut Bridge",
  "version": "1.0.0",
  "description": "Gửi content từ Claude trực tiếp vào AutoCapCut — bôi đen text, bấm 1 phát là xong.",

  "permissions": ["activeTab"],

  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1:8765/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "AutoCapCut Bridge"
  }
}
